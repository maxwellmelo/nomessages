<?xml version="1.0" encoding="utf-8"?>
<!--
  Concept (2026-09-16, replaces the bubble+padlock version): sober chat bubble (rounded
  rectangle, chamfered notch bottom-left instead of a pointed WhatsApp-style tail), crossed
  by a diagonal accent-colored slash — "no messages stored/intercepted" ("silenced bubble").
  Both shapes stay inside the 66dp safe-zone circle (radius 33 from the 54,54 center) so every
  adaptive-icon mask (circle / squircle / rounded square) keeps the full glyph visible. The
  slash uses strokeLineCap="butt" (not round) precisely because a round cap would bulge past
  its endpoint by half the stroke width along the diagonal, pushing it outside the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chat bubble contour: rounded rect, chamfered bottom-left corner as the "notch". -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/ic_launcher_glyph"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,34 L70,34 A8,8 0 0 1 78,42 L78,66 A8,8 0 0 1 70,74 L38,74 L30,66 L30,42 A8,8 0 0 1 38,34 Z" />

    <!-- Diagonal "silenced" slash, drawn on top of the bubble contour (no gap, see docs/changes/ic_launcher.md). -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/ic_launcher_accent"
        android:strokeWidth="6"
        android:strokeLineCap="butt"
        android:pathData="M33,33 L75,75" />
</vector>
